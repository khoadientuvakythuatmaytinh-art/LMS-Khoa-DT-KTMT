rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('disabled', false) == false;
    }

    // Ảnh giao diện chung do quản trị viên tải lên.
    match /system-theme/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }

    // File đề thi.
    match /de_thi/{allPaths=**} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.size < 25 * 1024 * 1024;
      allow delete: if signedIn();
      allow update: if false;
    }

    // Bài nộp theo cấu trúc mới.
    match /bai_nop/{hocPhanId}/{deThiId}/{userId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 25 * 1024 * 1024;
      allow delete: if signedIn();
      allow update: if false;
    }

    // Tương thích đường dẫn bản cũ.
    match /bai_nop/{hocPhanId}/{userId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 25 * 1024 * 1024;
      allow delete: if signedIn();
      allow update: if false;
    }

    // Tương thích bản rất cũ.
    match /bai_nop/{fileName} {
      allow read, delete: if signedIn();
      allow create: if signedIn() && request.resource.size < 25 * 1024 * 1024;
      allow update: if false;
    }
  }
}
